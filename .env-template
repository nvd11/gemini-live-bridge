# ==============================================================================
# Gemini Live Bridge - Local Environment Variables Template (.env-template)
#
# Instructions:
#   1. Copy this file to .env:
#        cp .env-template .env
#   2. Fill in your real Gemini API key / IM platform secrets.
#   3. The .env file is strictly ignored by Git (.gitignore) to prevent leaks.
#   4. Variable names follow POSIX UPPER_UNDERSCORE and map automatically onto
#      asia.jppwl.bridge.config.BridgeConfig via Quarkus @ConfigMapping:
#        bridge.gemini.api-key  <->  BRIDGE_GEMINI_API_KEY
# ==============================================================================

# ------------------------------------------------------------------------------
# [Required] Service public identity
# ------------------------------------------------------------------------------
# Public HTTPS base URL used to compose H5 call links and WSS endpoints.
BRIDGE_PUBLIC_BASE_URL=https://voice.jppwl.asia

# [Optional] Deployment environment label (dev / production). Default: production
BRIDGE_ENVIRONMENT=dev

# ------------------------------------------------------------------------------
# [Required] Google Gemini 3.8 Live API
# ------------------------------------------------------------------------------
# Your Google AI Studio / Vertex API key. NEVER commit the real value.
BRIDGE_GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# [Optional] Model variant. Default: gemini-3.8-live
#   Alternatives: gemini-3.8-live-extended-thinking
BRIDGE_GEMINI_MODEL_NAME=gemini-3.8-live

# [Optional] Prebuilt voice persona. Default: Puck
#   One of: Aoede, Charon, Fenrir, Kore, Puck
BRIDGE_GEMINI_VOICE_NAME=Puck

# [Optional] Agent system instruction (persona).
BRIDGE_GEMINI_SYSTEM_INSTRUCTION=你叫Hebe，是主人的专属贴心女仆与专业个人秘书。语言风格自然、温暖、干练，回答言简意赅。

# ------------------------------------------------------------------------------
# [Required] Session token & call lifecycle guardrails
# ------------------------------------------------------------------------------
# Random 32-byte hex string used to sign one-time ephemeral session tokens.
# Generate with: openssl rand -hex 32
BRIDGE_SESSION_SECRET_KEY=generate_a_random_32_bytes_hex_string_here

# [Optional] Ephemeral token TTL in seconds. Default: 300
BRIDGE_SESSION_TOKEN_TTL_SECONDS=300

# [Optional] Hard ceiling for a single call in seconds. Default: 1800 (30 min)
BRIDGE_SESSION_MAX_CALL_DURATION_SECONDS=1800

# [Optional] Idle silence circuit-breaker in seconds. Default: 120
BRIDGE_SESSION_IDLE_TIMEOUT_SECONDS=120

# ------------------------------------------------------------------------------
# [Optional] Feishu / Lark Open Platform (omit entirely for Slack-only deploys)
# ------------------------------------------------------------------------------
BRIDGE_FEISHU_APP_ID=cli_xxxxxxxxxxxxxx
BRIDGE_FEISHU_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
BRIDGE_FEISHU_VERIFICATION_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BRIDGE_FEISHU_ENCRYPT_KEY=

# ------------------------------------------------------------------------------
# [Optional] Slack App
# ------------------------------------------------------------------------------
BRIDGE_SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxx
BRIDGE_SLACK_SIGNING_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
